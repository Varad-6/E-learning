# Kaizen LMS Environment Configuration Template
# Copy to .env and replace all placeholder values before deploying.

ENVIRONMENT=production

# PostgreSQL connection
POSTGRES_USER=elearning_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=elearning
DATABASE_URL=postgresql://elearning_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/elearning
# BACKUP_DATABASE_URL=

# Cryptographic JWT signing keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS_ACCESS_SECRET
REFRESH_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS_REFRESH_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=https://kaizen.abhiyantatech.com

# Runtime options
UVICORN_WORKERS=2
RUN_SEED_ON_START=false

# SMTP configuration for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@abhiyantatech.com
SMTP_TLS=true
